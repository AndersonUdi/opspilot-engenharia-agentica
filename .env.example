# ---------------------------------------------------------------------------
# NO CODESPACE você NÃO precisa deste arquivo: cadastre os valores como
# *Codespaces secrets* (github.com → Settings → Codespaces → New secret).
# Este arquivo é o plano B para quem roda localmente:  cp .env.example .env
# NUNCA faça commit do .env (ele já está no .gitignore).
# ---------------------------------------------------------------------------

# Obrigatória (todas as aulas)
OPENAI_API_KEY=sk-...

# Opcional: modelo no formato provedor:modelo (padrão: openai:gpt-5.4-mini)
# OPENAI_MODEL=openai:gpt-5.4-mini
# OPENAI_JUDGE_MODEL=openai:gpt-5.4-mini

# Aula 4 — Langfuse Cloud (https://cloud.langfuse.com → projeto → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Use a região do seu projeto: https://cloud.langfuse.com (UE) ou https://us.cloud.langfuse.com (EUA)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
